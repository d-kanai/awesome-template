# ==================================================
# 環境変数（E2Eテスト用 - Mock Mode）
# ==================================================
# ⚠️ 重要: 全ての環境変数が必須です
# 必須の環境変数が不足していると、Next.js起動時にエラーになります
# ==================================================

# ==================================================
# Node環境
# ==================================================

NODE_ENV=test

# ==================================================
# アプリ環境（必須）
# ==================================================

ENV=test

# ==================================================
# API設定（必須）
# ==================================================

# バックエンドAPIのベースURL
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# APIモックモード（必須: "true" | "false"）
# E2Eテスト（Mock Mode）ではモックAPIを使用
NEXT_PUBLIC_API_MOCK_MODE=true

# APIタイムアウト設定（オプション、デフォルト: 30000ms = 30秒）
# E2Eテストでは短めに設定してテストを高速化
NEXT_PUBLIC_API_TIMEOUT_MS=10000

# Slow Request閾値（必須: ミリ秒）
NEXT_PUBLIC_API_SLOW_THRESHOLD_MS=3000

# ==================================================
# Mockoon Mock Server（E2E Testing Support）
# ==================================================

# Mockoon有効化フラグ（必須: "true" | "false"）
# Mock ModeではMockoonは不要（フロントエンドのモックを使用）
NEXT_PUBLIC_MOCKOON_ENABLED=false

# Mockoon Admin API URL（必須）
NEXT_PUBLIC_MOCKOON_ADMIN_URL=http://localhost:3002/__admin

# ==================================================
# Bundle Analyzer（必須）
# ==================================================

# Bundle分析を有効化（必須: "true" | "false"）
ANALYZE=false

