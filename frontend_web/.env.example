# ==================================================
# 環境変数テンプレート
# ==================================================
# このファイルをコピーして .env.local を作成してください
#
# ⚠️ 重要: 全ての環境変数が必須です
# 必須の環境変数が不足していると、Next.js起動時にエラーになります
# ==================================================

# ==================================================
# アプリ環境（必須）
# ==================================================

# アプリ環境（NODE_ENVと別に管理、stagingではNODE_ENV=productionになるため）
# "development" | "staging" | "production"
ENV=development

# ==================================================
# API設定（必須）
# ==================================================

# バックエンドAPIのベースURL
# 開発環境: http://localhost:8080
# 本番環境: https://api.example.com
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# APIモックモード（必須: "true" | "false"）
# true: モックレスポンスを返す（バックエンド未実装時）
# false: 実際のAPIを呼び出す
NEXT_PUBLIC_API_MOCK_MODE=true

# APIタイムアウト設定（オプション、デフォルト: 30000ms = 30秒）
# 全てのAPIリクエストに適用されるタイムアウト時間
# 本番環境では 15000ms (15秒)、開発環境では 30000ms (30秒) を推奨
# 個別のAPIで異なるタイムアウトが必要な場合は、リクエストオプションで上書き可能
NEXT_PUBLIC_API_TIMEOUT_MS=30000

# Slow Request閾値（必須: ミリ秒）
# この閾値を超えたリクエストはwarnレベルでログ出力される
NEXT_PUBLIC_API_SLOW_THRESHOLD_MS=3000

# ==================================================
# Bundle Analyzer（必須）
# ==================================================

# Bundle分析を有効化（必須: "true" | "false"）
# 通常は "false"、pnpm build:analyze 時は自動的に "true" に設定される
ANALYZE=false

# ==================================================
# Figma連携（オプショナル）
# ==================================================

# Figma Personal Access Token
# 取得方法: https://help.figma.com/hc/en-us/articles/8085703771159-Manage-personal-access-tokens
# FIGMA_ACCESS_TOKEN=your_token_here

# Figma File Key
# Figmaファイル URL: https://www.figma.com/file/FILE_KEY/...
# FIGMA_FILE_KEY=your_file_key_here

