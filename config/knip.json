{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "include": ["files", "dependencies", "unlisted", "exports"],
  "workspaces": {
    ".": {
      "entry": [
        "app/**/*.{ts,tsx}",
        "features/**/*.{ts,tsx}",
        "e2e/**/*.{js,ts}"
      ],
      "project": ["**/*.{ts,tsx,js,jsx}"],
      "ignore": [
        "coverage/**",
        "**/*.config.{js,ts,cjs,mjs}",
        "next.config.ts",
        "tailwind.config.ts",
        "postcss.config.mjs",
        "orval.config.ts",
        "vitest.config.ts",
        "playwright.config.ts",
        "cucumber.js",
        "e2e/steps/*.ts",
        "features/shared/api/generated/**",
        "features/shared/figma_generated/**"
      ],
      "ignoreDependencies": [
        "@tanstack/react-query-devtools",
        "@vitest/coverage-v8",
        "jsdom"
      ]
    }
  }
}
