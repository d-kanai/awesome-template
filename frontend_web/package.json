{
  "name": "frontend_web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.12.0",
    "pnpm": "10.10.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:mock": "NEXT_PUBLIC_API_MOCK_MODE=enabled next dev",
    "build": "next build",
    "build:analyze": "ANALYZE=true next build",
    "start": "next start",
    "lint": "biome check --config-path config/biome.json .",
    "lint:fix": "biome check --config-path config/biome.json --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config config/vitest.config.ts",
    "test:watch": "vitest --config config/vitest.config.ts",
    "test:coverage": "vitest run --coverage --config config/vitest.config.ts",
    "test:e2e": "cucumber-js --config e2e/cucumber.cjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "generate:api": "orval --config config/orval.config.ts",
    "figma:connect:publish": "export $(cat .env.local | grep FIGMA_ACCESS_TOKEN) && figma connect publish",
    "figma:connect:publish:dir": "export $(cat .env.local | grep FIGMA_ACCESS_TOKEN) && figma connect publish --dir",
    "figma:connect:unpublish": "export $(cat .env.local | grep FIGMA_ACCESS_TOKEN) && figma connect unpublish",
    "figma:connect:unpublish:node": "export $(cat .env.local | grep FIGMA_ACCESS_TOKEN) && figma connect unpublish --label React --node",
    "docker:build": "docker build -f docker/Dockerfile -t frontend_web:latest .",
    "docker:run": "docker run -p 3000:3000 -e NODE_ENV=production -e NEXT_PUBLIC_API_BASE_URL=http://localhost:8080 frontend_web:latest",
    "docker:up": "docker-compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker-compose -f docker/docker-compose.yml down",
    "docker:logs": "docker-compose -f docker/docker-compose.yml logs -f"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-query": "5.90.5",
    "@tanstack/react-query-devtools": "5.90.2",
    "@unleash/proxy-client-react": "5.0.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "next": "15.1.4",
    "next-themes": "^0.4.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.66.0",
    "tailwind-merge": "2.6.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@cucumber/cucumber": "11.1.0",
    "@faker-js/faker": "^9.9.0",
    "@figma/code-connect": "^1.3.8",
    "@next/bundle-analyzer": "^16.0.3",
    "@playwright/test": "1.49.1",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/addon-links": "^8.6.14",
    "@storybook/blocks": "^8.6.14",
    "@storybook/react": "^8.6.14",
    "@storybook/react-vite": "^8.6.14",
    "@storybook/test": "^8.6.14",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "22.10.2",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.0.2",
    "@vitejs/plugin-react": "4.3.4",
    "@vitest/coverage-v8": "2.1.8",
    "autoprefixer": "10.4.20",
    "dotenv": "^17.2.3",
    "jsdom": "25.0.1",
    "knip": "5.66.4",
    "next-router-mock": "^1.0.4",
    "openapi-types": "^12.1.3",
    "orval": "7.1.1",
    "postcss": "8.4.49",
    "storybook": "^8.6.14",
    "tailwindcss": "3.4.17",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "5.9.2",
    "unleash-proxy-client": "^3.7.8",
    "vitest": "2.1.8",
    "wait-on": "^9.0.1"
  },
  "msw": {
    "workerDirectory": ["public"]
  }
}
