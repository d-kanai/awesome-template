{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "organizeImports": {
    "enabled": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        "noUnusedImports": "error"
      },
      "style": {
        "useImportType": "off"
      },
      "complexity": {
        "useLiteralKeys": "off"
      },
      "suspicious": {
        "noConsoleLog": "error"
      }
    }
  },
  "files": {
    "ignore": [
      "node_modules",
      "build",
      "dist",
      ".next",
      "out",
      "coverage",
      "features/shared/api/generated",
      "features/shared/figma_generated",
      "styles/figma",
      "**/*.stories.tsx",
      "**/*.stories.ts"
    ]
  },
  "overrides": [
    {
      "include": ["features/shared/lib/logger.ts", "e2e/**/*"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsoleLog": "off"
          }
        }
      }
    }
  ]
}
