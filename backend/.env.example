# Environment: DEVELOPMENT | STAGING | PRODUCTION | TEST
ENV=DEVELOPMENT

# Server
PORT=8080

# Database
DATABASE_URL=jdbc:postgresql://localhost:5432/demodb
DATABASE_USERNAME=demo
DATABASE_PASSWORD=demo123

# JWT
JWT_SECRET=your-secret-key-that-is-at-least-256-bits-long-for-hs256
JWT_EXPIRATION_HOURS=720
JWT_COOKIE_SECURE=false

# CORS (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Kafka
KAFKA_ENABLED=true
KAFKA_SERVER_URL=localhost:9092

# Email
EMAIL_FROM=noreply@example.com
EMAIL_REPLY_TO=support@example.com

# ==================================================
# Mockoon Mock Server
# ==================================================
# Enable Mockoon for E2E testing and development
# Set to true to use Mockoon instead of real external APIs
MOCKOON_ENABLED=false
MOCKOON_ADMIN_URL=http://localhost:3001/__admin
MOCKOON_API_URL=http://localhost:3001

# External APIs
# When MOCKOON_ENABLED=true, these should point to Mockoon
# When MOCKOON_ENABLED=false, these should point to real APIs
EXTERNAL_API_PAYMENT_URL=http://localhost:3001/api/payment
EXTERNAL_API_SMS_URL=http://localhost:3001/api/sms
