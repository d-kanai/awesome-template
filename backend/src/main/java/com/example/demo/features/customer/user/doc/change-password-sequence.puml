@startuml
skinparam backgroundColor #FAFAFA

' ==== actor（外部）: グレー ====
skinparam actor {
  BackgroundColor #E0E0E0
  BorderColor #757575
  FontColor #424242
}

' ==== database / table: グレー ====
skinparam database {
  BackgroundColor #E0E0E0
  BorderColor #757575
  FontColor #424242
}

' ==== participant デフォルト: Application（青） ====
skinparam participant {
  BackgroundColor #E3F2FD
  BorderColor #1565C0
  FontColor #0D47A1
}

actor User

' Presentation（Controller）: オレンジ
participant Controller #FFE0B2

' Application（Command）: デフォルトの青
participant ChangePasswordCommand as Command

' Domain（DomainModel）: 緑
participant User as DomainModel #C8E6C9

' Infrastructure（Repo）: 紫
participant UserRepository as Repo #E1BEE7

' Database: グレー
database UserTable

User -> Controller: PUT /users/changePassword\n(currentPassword, newPassword)
Controller -> Controller: AuthContext.getCurrentUserId()
Controller -> Command: execute(input)

Command -> Repo: findById(userId)
Repo --> Command: DomainModel

Command -> Command: verifyCurrentPassword(user, currentPassword)
Command -> DomainModel: changePassword(newPassword)

Command -> Repo: update(DomainModel)
Repo -> UserTable: UPDATE user
UserTable --> Repo

Command --> Controller: Output
Controller --> User: 200 OK
@enduml
