@startuml
skinparam backgroundColor #FAFAFA

' ==== note（コメント）: 控えめなグレー ====
skinparam note {
  BackgroundColor #F5F5F5
  BorderColor #BDBDBD
  FontColor #757575
}

' ==== actor（外部）: グレー ====
skinparam actor {
  BackgroundColor #E0E0E0
  BorderColor #757575
  FontColor #424242
}

' ==== database / table: グレー ====
skinparam database {
  BackgroundColor #E0E0E0
  BorderColor #757575
  FontColor #424242
}

' ==== participant デフォルト: Application（青） ====
skinparam participant {
  BackgroundColor #E3F2FD
  BorderColor #1565C0
  FontColor #0D47A1
}

actor User

' Presentation（Controller）: オレンジ
participant FindAllUsersRestApi as Controller #FFE0B2

' Application（Query）: デフォルトの青
participant FindAllUsersQuery as Query

' Infrastructure（Repo）: 紫
participant UserRepository as Repo #E1BEE7

' Database: グレー
database UserTable

User -> Controller: GET /users
Controller -> Query: execute()

Query -> Repo: findAll()
Repo -> UserTable: SELECT * FROM user
UserTable --> Repo: rows
Repo --> Query: List<User>

Query --> Controller: Output(users)
Controller --> User: 200 OK
@enduml
