{
  "name": "frontend_web",
  "version": "~0.1.0",
  "private": true,
  "engines": {
    "node": "22.21.1",
    "pnpm": "~10.10.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "dev:mock": "NEXT_PUBLIC_API_MOCK_MODE=true next dev --webpack",
    "dev:turbo": "next dev",
    "dev:mock:turbo": "NEXT_PUBLIC_API_MOCK_MODE=true next dev",
    "build": "next build",
    "build:analyze": "ANALYZE=true next build",
    "start": "next start",
    "lint": "biome check app features e2e api_mock_mode",
    "lint:fix": "biome check --write app features e2e api_mock_mode",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:coverage": "vitest run --coverage --config vitest.config.ts",
    "test:e2e": "cucumber-js --config e2e/cucumber.cjs",
    "test:e2e:mock": "dotenv -e .env.test.mock -- cucumber-js --config e2e/cucumber.cjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "generate:api": "orval --config orval.config.ts",
    "figma:connect:publish": "export $(cat .env.local | grep FIGMA_ACCESS_TOKEN) && figma connect publish",
    "figma:connect:publish:dir": "export $(cat .env.local | grep FIGMA_ACCESS_TOKEN) && figma connect publish --dir",
    "figma:connect:unpublish": "export $(cat .env.local | grep FIGMA_ACCESS_TOKEN) && figma connect unpublish",
    "figma:connect:unpublish:node": "export $(cat .env.local | grep FIGMA_ACCESS_TOKEN) && figma connect unpublish --label React --node",
    "docker:build": "docker build -f Dockerfile -t frontend_web:latest .",
    "docker:run": "docker run -p 3000:3000 -e NODE_ENV=production -e NEXT_PUBLIC_API_BASE_URL=http://localhost:8080 frontend_web:latest"
  },
  "dependencies": {
    "@hookform/resolvers": "~5.2.2",
    "@tanstack/react-query": "~5.90.10",
    "@tanstack/react-query-devtools": "~5.90.2",
    "@unleash/proxy-client-react": "~5.0.1",
    "class-variance-authority": "~0.7.1",
    "clsx": "~2.1.1",
    "date-fns": "~4.1.0",
    "date-fns-tz": "~3.2.0",
    "next": "~16.0.3",
    "next-themes": "~0.4.6",
    "pino": "~9.5.0",
    "pino-pretty": "~13.0.0",
    "react": "~19.1.1",
    "react-dom": "~19.1.1",
    "react-hook-form": "~7.66.0",
    "tailwind-merge": "~3.0.2",
    "zod": "~3.25.76",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@biomejs/biome": "~2.3.6",
    "@cucumber/cucumber": "~12.0.0",
    "@executeautomation/playwright-mcp-server": "^1.0.6",
    "@faker-js/faker": "~9.9.0",
    "@figma/code-connect": "~1.3.9",
    "@next/bundle-analyzer": "~16.0.3",
    "@playwright/test": "~1.56.1",
    "@storybook/addon-links": "~10.0.7",
    "@storybook/react": "~10.0.7",
    "@storybook/react-vite": "~10.0.7",
    "@tailwindcss/postcss": "~4.0.17",
    "@testing-library/dom": "~10.0.0",
    "@testing-library/jest-dom": "~6.6.4",
    "@testing-library/react": "~16.1.0",
    "@testing-library/user-event": "~14.5.2",
    "@types/node": "~22.12.0",
    "@types/react": "~19.1.17",
    "@types/react-dom": "~19.0.6",
    "@vitejs/plugin-react": "~5.0.4",
    "@vitest/coverage-v8": "~4.0.9",
    "@vitest/ui": "~4.0.9",
    "autoprefixer": "~10.4.22",
    "dotenv": "~17.2.3",
    "dotenv-cli": "^11.0.0",
    "happy-dom": "~20.0.10",
    "jsdom": "~27.0.1",
    "knip": "~5.66.4",
    "next-router-mock": "~1.0.4",
    "openapi-types": "~12.1.3",
    "orval": "~7.1.1",
    "postcss": "~8.4.49",
    "storybook": "~10.0.7",
    "tailwindcss": "~4.0.17",
    "ts-node": "~10.9.2",
    "tsx": "~4.20.6",
    "typescript": "~5.9.3",
    "unleash-proxy-client": "~3.7.8",
    "vitest": "~4.0.9",
    "wait-on": "~9.0.3"
  }
}
