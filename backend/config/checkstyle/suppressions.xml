<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC
    "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
    "https://checkstyle.org/dtds/suppressions_1_2.dtd">
<suppressions>
    <!-- jOOQ generated code -->
    <suppress files=".*[/\\]shared[/\\]jooq[/\\].*\.java$" checks=".*"/>
    <!-- Test files: MethodLength not enforced -->
    <suppress files=".*[/\\]src[/\\]test[/\\].*\.java$" checks="MethodLength"/>
</suppressions>
