# Figma API設定
# Figmaのデザイントークンを自動同期するために必要です

# Figma Personal Access Token
# 取得方法: https://help.figma.com/hc/en-us/articles/8085703771159-Manage-personal-access-tokens
# 必要なスコープ: File content (read-only)
FIGMA_ACCESS_TOKEN=figd_xxxxx...

# Figma File Key
# Figmaファイル URL: https://www.figma.com/file/FILE_KEY/...
# FILE_KEY の部分を以下に設定
FIGMA_FILE_KEY=

# 使用例: Figma Community SDS
# File: https://www.figma.com/community/file/1323286958747522747/simple-design-system
# FIGMA_FILE_KEY=1323286958747522747
