{
  "openapi": "3.0.1",
  "info": {
    "title": "Awesome Template API",
    "description": "Awesome Template バックエンドサービスの API ドキュメントです。",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Generated server url"
    }
  ],
  "tags": [
    {
      "name": "E2Eテスト支援",
      "description": "E2Eテストで利用するデータセットアップの補助APIです"
    },
    {
      "name": "認証",
      "description": "ユーザー認証・登録に関連する操作です"
    },
    {
      "name": "フィーチャーフラグ",
      "description": "フィーチャーフラグに関連する操作です"
    },
    {
      "name": "ユーザー",
      "description": "ユーザーを管理するための操作です"
    },
    {
      "name": "ユーザーの声",
      "description": "ユーザーの声に関連する操作です"
    }
  ],
  "paths": {
    "/featureflags/proxy": {
      "get": {
        "tags": ["フィーチャーフラグ"],
        "summary": "フィーチャーフラグ取得 (GET)",
        "description": "すべての有効なフィーチャーフラグを取得します。Unleash Proxy互換のエンドポイントです。",
        "operationId": "getFeaturesGet",
        "responses": {
          "200": {
            "description": "フィーチャーフラグの取得に成功しました。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProxyResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["フィーチャーフラグ"],
        "summary": "フィーチャーフラグ取得 (POST)",
        "description": "すべての有効なフィーチャーフラグを取得します。Unleash Proxy互換のエンドポイントです。",
        "operationId": "getFeaturesPost",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProxyRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "フィーチャーフラグの取得に成功しました。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProxyResponse"
                }
              }
            }
          }
        }
      }
    },
    "/e2e/reset_data": {
      "post": {
        "tags": ["E2Eテスト支援"],
        "summary": "DBをリセット",
        "description": "アプリケーションが管理するテーブルからデータをすべて削除します。",
        "operationId": "resetData",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/e2e/dummy_token": {
      "post": {
        "tags": ["E2Eテスト支援"],
        "summary": "E2Eテスト用トークン生成",
        "description": "E2Eテストでauth guardをバイパスするためのダミートークンを生成します。setCookie=trueの場合、httpOnly Cookieとしても設定します。",
        "operationId": "generateDummyToken",
        "parameters": [
          {
            "name": "setCookie",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/TestTokenResponse"
                }
              }
            }
          }
        }
      }
    },
    "/e2e/create_data": {
      "post": {
        "tags": ["E2Eテスト支援"],
        "summary": "テストデータをセットアップ",
        "description": "指定されたテーブルにテストデータを1レコード作成します。",
        "operationId": "createData",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetupDataRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/auth/signup": {
      "post": {
        "tags": ["認証"],
        "summary": "ユーザー登録",
        "description": "指定した情報で新しいユーザーを登録します。",
        "operationId": "signup",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignupRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "ユーザーの登録に成功しました。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignupResponse"
                }
              }
            }
          },
          "400": {
            "description": "リクエストペイロードが不正です。"
          }
        }
      }
    },
    "/auth/signin": {
      "post": {
        "tags": ["認証"],
        "summary": "サインイン",
        "description": "メールアドレスとパスワードでサインインします。",
        "operationId": "signin",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SigninRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "400": {
            "description": "メールアドレスまたはパスワードが正しくありません。"
          },
          "200": {
            "description": "サインインに成功しました。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SigninResponse"
                }
              }
            }
          }
        }
      }
    },
    "/users": {
      "get": {
        "tags": ["ユーザー"],
        "summary": "ユーザー一覧を取得",
        "description": "登録されているすべてのユーザーを取得します。",
        "operationId": "getAllUsers",
        "responses": {
          "200": {
            "description": "ユーザーの取得に成功しました。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FindAllUsersResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "tags": ["認証"],
        "summary": "認証済みユーザー情報取得",
        "description": "現在認証されているユーザーの情報を取得します。",
        "operationId": "me",
        "responses": {
          "401": {
            "description": "認証されていません。"
          },
          "200": {
            "description": "ユーザー情報の取得に成功しました。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          }
        }
      }
    },
    "/user-voices": {
      "get": {
        "tags": ["ユーザーの声"],
        "summary": "ユーザーの声取得",
        "description": "ユーザーの声一覧を取得します。",
        "operationId": "getUserVoices",
        "responses": {
          "200": {
            "description": "ユーザーの声の取得に成功しました。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetUserVoicesResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ProxyRequest": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string"
          },
          "properties": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      },
      "FeatureToggle": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "variant": {
            "type": "string"
          },
          "variantEnabled": {
            "type": "boolean"
          }
        }
      },
      "ProxyResponse": {
        "type": "object",
        "properties": {
          "toggles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FeatureToggle"
            }
          }
        }
      },
      "TestTokenResponse": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "JWTトークン",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
          }
        },
        "description": "E2Eテスト用トークン"
      },
      "SetupDataRequest": {
        "type": "object",
        "properties": {
          "table": {
            "type": "string",
            "description": "テーブル名 (例: user)",
            "example": "user"
          }
        },
        "description": "テストデータセットアップリクエスト"
      },
      "SignupRequest": {
        "required": ["email", "password"],
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "ユーザーのメールアドレス",
            "example": "jane.doe@example.com"
          },
          "password": {
            "type": "string",
            "description": "ユーザーのパスワード",
            "example": "SecurePassword123"
          }
        },
        "description": "新しいユーザーを登録するためのリクエストペイロードです"
      },
      "SignupResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "ユーザーの一意な識別子",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "description": "ユーザーのメールアドレス",
            "example": "jane.doe@example.com"
          },
          "createdAt": {
            "type": "string",
            "description": "ユーザーの作成日時",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "description": "ユーザーの最終更新日時",
            "format": "date-time"
          }
        },
        "description": "新しく作成されたユーザーを表します"
      },
      "SigninRequest": {
        "required": ["email", "password"],
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "ユーザーのメールアドレス",
            "example": "jane.doe@example.com"
          },
          "password": {
            "type": "string",
            "description": "ユーザーのパスワード",
            "example": "SecurePassword123"
          }
        },
        "description": "ユーザーがサインインするためのリクエストペイロードです"
      },
      "SigninResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "ユーザーの一意な識別子",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "description": "ユーザーのメールアドレス",
            "example": "jane.doe@example.com"
          },
          "accessToken": {
            "type": "string",
            "description": "JWT認証トークン",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
          },
          "createdAt": {
            "type": "string",
            "description": "ユーザーの作成日時",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "description": "ユーザーの最終更新日時",
            "format": "date-time"
          }
        },
        "description": "サインインしたユーザーを表します"
      },
      "FindAllUsersResponse": {
        "type": "object",
        "properties": {
          "users": {
            "type": "array",
            "description": "ユーザーの一覧です",
            "items": {
              "$ref": "#/components/schemas/UserListItem"
            }
          }
        },
        "description": "登録済みユーザーの一覧を表します"
      },
      "UserListItem": {
        "required": ["createdAt", "email", "id", "updatedAt"],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "ユーザーの一意な識別子",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "description": "ユーザーのメールアドレス",
            "example": "jane.doe@example.com"
          },
          "createdAt": {
            "type": "string",
            "description": "ユーザーの作成日時",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "description": "ユーザーの最終更新日時",
            "format": "date-time"
          }
        },
        "description": "一覧レスポンス内のユーザー情報です"
      },
      "MeResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "ユーザーの一意な識別子",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "description": "ユーザーのメールアドレス",
            "example": "jane.doe@example.com"
          }
        },
        "description": "認証済みユーザーの情報を表します"
      },
      "UserVoice": {
        "required": ["avatarSrc", "description", "quote", "title"],
        "type": "object",
        "properties": {
          "avatarSrc": {
            "type": "string",
            "description": "アバター画像のURL",
            "example": "/images/avatars/user1.jpg"
          },
          "title": {
            "type": "string",
            "description": "ユーザー名",
            "example": "田中太郎"
          },
          "description": {
            "type": "string",
            "description": "役職・所属",
            "example": "株式会社サンプル CTO"
          },
          "quote": {
            "type": "string",
            "description": "ユーザーの声（引用）",
            "example": "このサービスは素晴らしいです。"
          }
        },
        "description": "ユーザーの声"
      },
      "GetUserVoicesResponse": {
        "type": "object",
        "properties": {
          "userVoices": {
            "type": "array",
            "description": "ユーザーの声一覧",
            "items": {
              "$ref": "#/components/schemas/UserVoice"
            }
          }
        },
        "description": "ユーザーの声一覧レスポンス"
      }
    }
  }
}
