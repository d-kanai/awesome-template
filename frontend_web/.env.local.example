# API設定
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_API_MOCK_MODE=false

# APIタイムアウト設定（オプション、デフォルト: 30000ms = 30秒）
# 本番環境では適切な値に調整してください
NEXT_PUBLIC_API_TIMEOUT_MS=30000

# アナリティクス
ANALYZE=false

# ログレベル（オプション: debug, info, warn, error）
# 未設定の場合: development=debug, production/test=info
LOG_LEVEL=debug
